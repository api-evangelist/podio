{
  "opencollection": "1.0.0",
  "info": {
    "name": "Podio Applications Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://podio.com/oauth/authorize",
      "accessTokenUrl": "https://api.podio.com/oauth/token/v2",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.podio.com/task/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new task, optionally attached to a reference object."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Podio Applications Hooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://podio.com/oauth/authorize",
      "accessTokenUrl": "https://api.podio.com/oauth/token/v2",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Hooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.podio.com/hook/:ref_type/:ref_id/",
            "params": [
              {
                "name": "ref_type",
                "value": "",
                "type": "path"
              },
              {
                "name": "ref_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new hook (webhook subscription) on the given reference object."
        }
      ]
    }
  ],
  "bundled": true
}